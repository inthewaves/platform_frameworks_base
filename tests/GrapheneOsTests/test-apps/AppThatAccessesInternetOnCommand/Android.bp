android_test_helper_app {
    name: "GosAppThatAccessesInternetOnCommand",
    defaults: [
        "cts_defaults",
        "mts-target-sdk-version-current",
    ],
    test_suites: [
        "cts",
        "general-tests",
        "sts",
        "mts-permission",
    ],
    sdk_version: "current",
    min_sdk_version: "30",
    srcs: [
        "src/**/*.java",
        "src/**/*.aidl"
    ],
}
